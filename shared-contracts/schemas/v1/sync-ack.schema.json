{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymcoach.local/contracts/watch/v1/sync-ack.schema.json",
  "title": "SyncAck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "schemaVersion",
    "ackId",
    "sessionId",
    "eventIds",
    "status",
    "timestamp",
    "source",
    "deviceId",
    "revision",
    "errorCode"
  ],
  "properties": {
    "protocolVersion": { "type": "string", "const": "1.0" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "ackId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "status": {
      "type": "string",
      "enum": ["APPLIED", "DUPLICATE", "STALE", "CONFLICT", "REJECTED"]
    },
    "timestamp": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "enum": ["PHONE", "WATCH"] },
    "deviceId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "errorCode": { "type": ["string", "null"] }
  }
}
