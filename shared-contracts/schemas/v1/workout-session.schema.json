{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymcoach.local/contracts/watch/v1/workout-session.schema.json",
  "title": "WorkoutSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "workoutProgramId",
    "userId",
    "status",
    "startedAt",
    "finishedAt",
    "activeExerciseId",
    "activeSetId",
    "revision",
    "updatedAt",
    "updatedBy"
  ],
  "properties": {
    "sessionId": { "type": "string", "format": "uuid" },
    "workoutProgramId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "FINISHED"] },
    "startedAt": { "type": "integer", "minimum": 0 },
    "finishedAt": { "type": ["integer", "null"], "minimum": 0 },
    "activeExerciseId": { "type": ["string", "null"], "format": "uuid" },
    "activeSetId": { "type": ["string", "null"], "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "integer", "minimum": 0 },
    "updatedBy": { "type": "string", "enum": ["PHONE", "WATCH"] }
  }
}
