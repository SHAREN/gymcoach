{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymcoach.local/contracts/watch/v1/control-message.schema.json",
  "title": "ControlMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "schemaVersion",
    "messageId",
    "type",
    "timestamp",
    "source",
    "deviceId",
    "replyTo",
    "payload"
  ],
  "properties": {
    "protocolVersion": { "type": "string", "const": "1.0" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "messageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "type": {
      "type": "string",
      "enum": ["PING", "PONG", "SYNC_REQUESTED", "SYNC_SNAPSHOT"]
    },
    "timestamp": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "enum": ["PHONE", "WATCH"] },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "replyTo": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "payload": { "type": "object" }
  }
}
